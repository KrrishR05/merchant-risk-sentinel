# RiskSūtra Environment Configuration

# Database — choose one:
# DB_TYPE=sqlite        (default for local dev, zero config)
# DB_TYPE=postgresql    (for production / deployment)
DB_TYPE=sqlite

# PostgreSQL connection (only needed when DB_TYPE=postgresql)
# DATABASE_URL=postgresql://risksutra:password@localhost:5432/risksutra

# SQLite path (only needed when DB_TYPE=sqlite)
# SQLITE_PATH=./data/risksutra.db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI (Day 3 — not used on Day 1)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o

# Logging
LOG_LEVEL=INFO
